# Kopirajte u .env i prilagodite. Pokretanje: node --env-file=.env server.js

# Adresa OpenTAKServera (ZeroTier adresa) - web sucelje/API
OTS_URL=https://ots.example.local
OTS_USERNAME=korisnik
OTS_PASSWORD=promijeni_me

# Samopotpisani certifikat: bolje je dati putanju do CA certifikata servera
# (npr. ca.pem kopiran s ~/ots/ca na ovo racunalo)...
# NODE_EXTRA_CA_CERTS=/putanja/do/ca.pem
# ...a samo za brzu probu na privatnoj mrezi mozete iskljuciti provjeru (samo za OTS klijent):
# OTS_INSECURE=1

# Putanje API-ja koje se citaju (odvojene zarezom). Ako ne radi, pogledajte /api/debug.
OTS_ENDPOINTS=/api/map_state,/api/eud,/api/markers

# Besplatan token s https://ion.cesium.com (Access Tokens) - za teren i zgrade
CESIUM_ION_TOKEN=

PORT=3000
# Sucelje nema prijavu: ostavite 127.0.0.1. Za drugo ime hosta dodajte ga u ALLOWED_HOSTS.
# HOST=127.0.0.1
# ALLOWED_HOSTS=
POLL_MS=2000

# /api/history: najvise stranica /api/cot koje se skeniraju za jedan upit (sigurnosna granica)
# OTS_HISTORY_MAX_PAGES=60

# Stvarni alarmi iz OTS-a (GET /api/alerts, npr. 911 s TAK klijenta). Prazno = iskljuceno.
# OTS_ALERTS_PATH=/api/alerts
# OTS_ALERTS_EVERY_MS=10000

# Alarm "niska baterija" za sve objekte koji javljaju bateriju (uredjaji, dronovi), u postocima
# OTS_LOW_BATTERY_PCT=20

# Uredjaji koji su odspojeni i ne javljaju dulje od ovoga skrivaju se na karti (sati)
# OTS_OFFLINE_HIDE_HOURS=24

# Prijava u aplikaciju (korisnici i lozinke su isti kao na OTS-u). Obavezna je cim HOST nije
# loopback (npr. 0.0.0.0); AUTH_REQUIRED=1 je ukljucuje i lokalno.
# AUTH_REQUIRED=1
# AUTH_SESSION_HOURS=12
# AUTH_MAX_ATTEMPTS_USER=5
# AUTH_MAX_ATTEMPTS_IP=10
# Iza vlastitog HTTPS reverznog proxyja: TRUST_PROXY=1 (X-Forwarded-*), a bez proxyja s
# HTTPS-om COOKIE_SECURE=1 (kolacic samo preko HTTPS-a)
# TRUST_PROXY=1
# COOKIE_SECURE=1

# Uloge: ako je prazno, svaki prijavljeni korisnik smije mijenjati markere, zone i rute.
# Kad je postavljeno (popis OTS uloga odvojen zarezom), mijenjati smiju samo oni s tom ulogom,
# ostali samo gledaju. Npr. AUTH_EDIT_ROLES=administrator
# AUTH_EDIT_ROLES=

# Iza nginxa pod podputanjom (npr. https://domena/karta/): COOKIE_PATH=/karta/ (zajedno s
# TRUST_PROXY=1, COOKIE_SECURE=1 i domenom u ALLOWED_HOSTS). Nginx skida prefiks, vidi README.
# COOKIE_PATH=/karta/

# HTTPS (Caddy, docker-compose.yml): domena za pravi Let's Encrypt certifikat; zadano localhost.
# Ovo se zadaje u okolini ili u .env uz docker-compose.yml, ne u aplikaciji.
# SITE_ADDRESS=karta.example.hr
# Dodajte domenu i u ALLOWED_HOSTS (gore), inace aplikacija odbija zahtjeve.
